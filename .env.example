# Copy to /etc/jit-firewall.env, chmod 600, generate a real token.
JIT_API_TOKEN=
JIT_HOST=127.0.0.1
JIT_PORT=8765
JIT_DATABASE=/var/lib/jit-firewall/rules.sqlite3
# Choose the chain matching your own firewall policy; do not change blindly.
JIT_CHAIN=FORWARD
JIT_PROTECTED_PORTS=22,8765,9080
# Empty for same-origin UI. For separate nginx UI, list exact origins, comma-separated.
JIT_CORS_ORIGINS=
